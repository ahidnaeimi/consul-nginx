{{- range services }}
  {{- $svc := service .Name }}
  upstream {{ .Name }} {
    {{- range $svc }}
    server {{ .Address }}:{{ .Port }};
    {{- else }}
    server 127.0.0.1:65535;
    {{- end }}
  }
{{- end }}

{{- range services }}
  {{- $svc := service .Name }}
  {{- if gt (len $svc) 0 }}
    {{- $host := "" }}
    {{- range (index $svc 0).Tags }}
      {{- if and (ge (len .) 13) (eq (slice . 0 13) "virtual_host=") }}
        {{- $host = (slice . 13) }}
      {{- end }}
    {{- end }}
    {{- if ne $host "" }}
server {
  listen 80;
  server_name {{ $host }};

  location / {
    proxy_pass http://{{ .Name }};
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  }
}
    {{- end }}
  {{- end }}
{{- end }}
